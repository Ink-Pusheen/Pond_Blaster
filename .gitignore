# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
Releases/1..1/Windows/AssetRegistry.bin
Releases/1..1/Windows/Metadata/DevelopmentAssetRegistry.bin
Releases/1..1/Windows/Pond_Blaster-Windows.pak
Releases/1..1/Windows/Pond_Blaster-Windows.ucas
Releases/1..1/Windows/Pond_Blaster-Windows.utoc
Releases/1.0/Windows/AssetRegistry.bin
Releases/1.0/Windows/Metadata/DevelopmentAssetRegistry.bin
Releases/1.0/Windows/Pond_Blaster-Windows.pak
Releases/1.0/Windows/Pond_Blaster-Windows.ucas
Releases/1.0/Windows/Pond_Blaster-Windows.utoc
